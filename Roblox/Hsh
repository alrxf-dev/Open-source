local function onExportConfigToClipboard()
    local success, encoded = pcall(HttpService.JSONEncode, HttpService, exportConfigToTable())
    if not success then
        Library:Notify("Failed to encode the config")
        return
    end
    local clipboardFunc = setclipboard or toclipboard
    if type(clipboardFunc) ~= "function" or not pcall(clipboardFunc, encoded) then
        Library:Notify("Your executor does not support copying to the clipboard")
        return
    end
    Library:Notify("Config copied to clipboard", 6)
end

local function onImportConfigFromClipboardText()
    local rawText = tostring(Options.SaveManager_ImportSource.Value or "")
    local trimmed = rawText:match("^%s*(.-)%s*$")
    if trimmed == "" then
        Library:Notify("Paste an exported config into the box first")
        return
    end
    local success, decoded = pcall(HttpService.JSONDecode, HttpService, trimmed)
    if not success or type(decoded) ~= "table" or type(decoded.objects) ~= "table" then
        Library:Notify("That is not a valid exported config")
        return
    end
    local appliedCount = 0
    for _, entry in ipairs(decoded.objects) do
        if applySerializedObject(entry) then
            appliedCount += 1
        end
    end
    if appliedCount == 0 then
        Library:Notify("No settings in that config matched this script")
        return
    end
    Options.SaveManager_ImportSource:SetValue("")
    Library:Notify(("Imported %d setting%s"):format(appliedCount, appliedCount == 1 and "" or "s"), 6)
end

