local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local CONFIG = {
	WalkSpeed = {Min = 16, Max = 120, Default = 16, Step = 4},
	JumpPower = {Min = 50, Max = 200, Default = 50, Step = 10},
	FlySpeed = {Min = 10, Max = 150, Default = 50, Step = 10},
}

local state = {
	walkSpeed = CONFIG.WalkSpeed.Default,
	jumpPower = CONFIG.JumpPower.Default,
	flySpeed = CONFIG.FlySpeed.Default,
	noclip = false,
	fly = false,
	infiniteJump = false,
}

local connections = {}
local flyBV, flyBG

local function getHumanoid()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function applyStats()
	local hum = getHumanoid()
	if hum then
		hum.WalkSpeed = state.walkSpeed
		hum.JumpPower = state.jumpPower
		hum.UseJumpPower = true
	end
end

local function setNoclip(on)
	state.noclip = on
end

local function stopFly()
	state.fly = false
	if flyBV then flyBV:Destroy() flyBV = nil end
	if flyBG then flyBG:Destroy() flyBG = nil end
	local hum = getHumanoid()
	if hum then hum.PlatformStand = false end
end

local function startFly()
	local root = getRoot()
	local hum = getHumanoid()
	if not root or not hum then return end
	state.fly = true
	hum.PlatformStand = true
	flyBV = Instance.new("BodyVelocity")
	flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
	flyBV.Velocity = Vector3.zero
	flyBV.Parent = root
	flyBG = Instance.new("BodyGyro")
	flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
	flyBG.P = 1e4
	flyBG.CFrame = root.CFrame
	flyBG.Parent = root
end

RunService.Stepped:Connect(function()
	local char = player.Character
	if not char then return end
	if state.noclip then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				part.CanCollide = false
			end
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if not state.fly or not flyBV then return end
	local cam = workspace.CurrentCamera
	local move = Vector3.zero
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += cam.CFrame.LookVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= cam.CFrame.LookVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += cam.CFrame.RightVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= cam.CFrame.RightVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.yAxis end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.yAxis end
	if move.Magnitude > 0 then move = move.Unit * state.flySpeed end
	flyBV.Velocity = move
	flyBG.CFrame = cam.CFrame
end)

UserInputService.JumpRequest:Connect(function()
	if not state.infiniteJump then return end
	local hum = getHumanoid()
	if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
end)

local function build()
	local gui = Instance.new("ScreenGui")
	gui.Name = "SkeuoPanel"
	gui.ResetOnSpawn = false
	gui.Parent = playerGui

	local main = Instance.new("Frame")
	main.Size = UDim2.fromOffset(300, 380)
	main.Position = UDim2.new(0.5, -150, 0.5, -190)
	main.BackgroundColor3 = Color3.fromRGB(58, 62, 70)
	main.BorderSizePixel = 0
	main.Parent = gui
	Instance.new("UICorner", main).CornerRadius = UDim.new(0, 14)

	local mainStroke = Instance.new("UIStroke", main)
	mainStroke.Color = Color3.fromRGB(20, 22, 26)
	mainStroke.Thickness = 2

	local grad = Instance.new("UIGradient", main)
	grad.Rotation = 90
	grad.Color = ColorSequence.new(Color3.fromRGB(78, 84, 94), Color3.fromRGB(38, 41, 48))

	local shadow = Instance.new("Frame")
	shadow.Size = UDim2.new(1, 6, 1, 6)
	shadow.Position = UDim2.fromOffset(3, 5)
	shadow.BackgroundColor3 = Color3.new(0, 0, 0)
	shadow.BackgroundTransparency = 0.6
	shadow.BorderSizePixel = 0
	shadow.ZIndex = 0
	shadow.Parent = main
	Instance.new("UICorner", shadow).CornerRadius = UDim.new(0, 14)

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 44)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.Text = "CONTROL PANEL"
	title.TextColor3 = Color3.fromRGB(220, 225, 232)
	title.TextSize = 17
	title.Parent = main

	local content = Instance.new("Frame")
	content.Position = UDim2.fromOffset(14, 52)
	content.Size = UDim2.new(1, -28, 1, -66)
	content.BackgroundTransparency = 1
	content.Parent = main

	local layout = Instance.new("UIListLayout", content)
	layout.Padding = UDim.new(0, 10)
	layout.SortOrder = Enum.SortOrder.LayoutOrder

	local function makeRecessed(parent, height)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, height)
		f.BackgroundColor3 = Color3.fromRGB(30, 32, 37)
		f.BorderSizePixel = 0
		f.Parent = parent
		Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
		local s = Instance.new("UIStroke", f)
		s.Color = Color3.fromRGB(12, 13, 16)
		s.Thickness = 1
		return f
	end

	local function makeSlider(label, cfg, key, onChange)
		local box = makeRecessed(content, 58)
		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.new(1, -16, 0, 20)
		lbl.Position = UDim2.fromOffset(8, 6)
		lbl.BackgroundTransparency = 1
		lbl.Font = Enum.Font.GothamBold
		lbl.TextColor3 = Color3.fromRGB(190, 196, 204)
		lbl.TextSize = 13
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.Parent = box

		local track = Instance.new("Frame")
		track.Size = UDim2.new(1, -16, 0, 8)
		track.Position = UDim2.new(0, 8, 0, 36)
		track.BackgroundColor3 = Color3.fromRGB(18, 19, 22)
		track.BorderSizePixel = 0
		track.Parent = box
		Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

		local fill = Instance.new("Frame")
		fill.BackgroundColor3 = Color3.fromRGB(120, 180, 255)
		fill.BorderSizePixel = 0
		fill.Parent = track
		Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

		local knob = Instance.new("Frame")
		knob.Size = UDim2.fromOffset(16, 16)
		knob.AnchorPoint = Vector2.new(0.5, 0.5)
		knob.BackgroundColor3 = Color3.fromRGB(225, 230, 238)
		knob.BorderSizePixel = 0
		knob.Parent = track
		Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

		local function setValue(v)
			v = math.clamp(math.floor(v + 0.5), cfg.Min, cfg.Max)
			local ratio = (v - cfg.Min) / (cfg.Max - cfg.Min)
			fill.Size = UDim2.new(ratio, 0, 1, 0)
			knob.Position = UDim2.new(ratio, 0, 0.5, 0)
			lbl.Text = label .. ": " .. v
			state[key] = v
			onChange(v)
		end

		local dragging = false
		track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local ratio = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
				setValue(cfg.Min + ratio * (cfg.Max - cfg.Min))
			end
		end)

		setValue(state[key])
		return setValue
	end

	local function makeToggle(label, key, onChange)
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, 40)
		btn.BackgroundColor3 = Color3.fromRGB(70, 76, 86)
		btn.BorderSizePixel = 0
		btn.AutoButtonColor = false
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 14
		btn.TextColor3 = Color3.fromRGB(230, 234, 240)
		btn.Parent = content
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
		local bs = Instance.new("UIStroke", btn)
		bs.Color = Color3.fromRGB(14, 15, 18)
		bs.Thickness = 1

		local function refresh()
			local on = state[key]
			btn.Text = label .. (on and "  [ON]" or "  [OFF]")
			btn.BackgroundColor3 = on and Color3.fromRGB(60, 120, 180) or Color3.fromRGB(70, 76, 86)
		end

		btn.Activated:Connect(function()
			state[key] = not state[key]
			refresh()
			onChange(state[key])
		end)
		refresh()
	end

	local setWalk = makeSlider("WalkSpeed", CONFIG.WalkSpeed, "walkSpeed", function(v)
		local hum = getHumanoid()
		if hum then hum.WalkSpeed = v end
	end)

	makeSlider("JumpPower", CONFIG.JumpPower, "jumpPower", function(v)
		local hum = getHumanoid()
		if hum then hum.JumpPower = v end
	end)

	makeToggle("Noclip", "noclip", setNoclip)

	makeToggle("Fly", "fly", function(on)
		if on then startFly() else stopFly() end
	end)

	makeToggle("Infinite Jump", "infiniteJump", function() end)

	player.CharacterAdded:Connect(function(char)
		local hum = char:WaitForChild("Humanoid")
		hum.WalkSpeed = state.walkSpeed
		hum.JumpPower = state.jumpPower
		hum.UseJumpPower = true
		if state.fly then
			state.fly = false
			startFly()
		end
	end)

	local toggleKey = Enum.KeyCode.RightShift
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then return end
		if input.KeyCode == toggleKey then
			gui.Enabled = not gui.Enabled
		end
	end)
end

build()
