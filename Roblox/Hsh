-- ============ AUTO FARM LOOP ============

local function autoFarmLoop()
    while true do
        task.wait(0.35)
        if Library.Unloaded then break end
        if Toggles.AutoTrain and Toggles.AutoTrain.Value then continue end

        local farmAllDungeons = Toggles.AutoFarmDungeons and Toggles.AutoFarmDungeons.Value
        local farmSelected = Toggles.AutoFarmSelected and Toggles.AutoFarmSelected.Value
        if not (farmAllDungeons or farmSelected) then
            currentStage = 1
            lastStageTeleported = nil
            continue
        end

        local maxStage = MAX_DUNGEON_STAGE
        if farmSelected then
            maxStage = tonumber(Options.SelectedStage.Value) or 1
        end

        local stageState = invokeServer(StageStateFunc)
        if not stageState then continue end

        local clearedStage = stageState.ClearedStage or 0
        local targetStage = math.min(currentStage, maxStage, clearedStage + 1)
        if targetStage < 1 then targetStage = 1 end

        currentStage = targetStage
        teleportToStage(targetStage, lastStageTeleported ~= targetStage)
        lastStageTeleported = targetStage

        local stageComplete = (stageState.EnteredStage == targetStage)
            and ((stageState.AliveEnemies or 0) == 0)
            and ((stageState.ClearedStage or 0) >= targetStage)

        if stageComplete then
            local shouldWaitForChest = Toggles.AutoOpenChest and Toggles.AutoOpenChest.Value and hasAvailableChest()
            if shouldWaitForChest then continue end

            if currentStage < maxStage then
                currentStage += 1
                lastStageTeleported = nil
            else
                local rootPart = getHumanoidRootPart()
                local levelFolder = workspace:FindFirstChild("Level")
                local firstStage = levelFolder and levelFolder:FindFirstChild(tostring(targetStage))
                local startPart = firstStage and firstStage:FindFirstChild("Start")
                if rootPart and startPart then
                    rootPart.CFrame = startPart.CFrame + Vector3.new(0, 4, 0)
                    task.wait(0.4)
                    teleportToStage(targetStage, true)
                end
            end
        end
    end
end

