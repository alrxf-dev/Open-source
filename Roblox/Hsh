-- ============ EQUIPMENT SCORING ============

local QUALITY_TIER = {
    Common = 1, UnCommon = 2, Rare = 3, Epic = 4,
    Legendary = 5, Mythical = 6, Exclusive = 7
}

local function equipmentScore(item)
    local tier = QUALITY_TIER[item.Quality] or 0
    local defenseScore = (item.HealthBonus or 0) + (item.Defense or 0) * 1000
    local attackScore = (item.AttackBonus or 0) * 1000
    return tier * 1000000 + defenseScore + attackScore + (item.CritRate or 0) * 1000
end

local function getMaxEquipmentForRebirth(rebirthCount)
    local maxEquipmentId = 1
    for _, equipData in ipairs(AutoTrainConfig.EQUIPMENT) do
        local req = equipData.Requirement or {}
        if req.Type == "Free" then
            maxEquipmentId = math.max(maxEquipmentId, equipData.EquipmentId)
        elseif req.Type == "Rebirth" and rebirthCount >= (req.Amount or math.huge) then
            maxEquipmentId = math.max(maxEquipmentId, equipData.EquipmentId)
        end
    end
    return maxEquipmentId
end

-- ============ CONFIG SERIALIZATION ============

local function findObjectByType(typeName, objectId)
    local sourceTable = (typeName == "Toggle" and Toggles or Options)
    local entry = sourceTable[objectId]
    local isValid = type(entry) == "table" and entry.Type == typeName
    return isValid and entry or nil
end

local function serializeObject(index, object)
    local objectType = object.Type
    if objectType == "Toggle" then
        return { idx = index, type = "Toggle", value = object.Value == true }
    elseif objectType == "Slider" then
        return { idx = index, type = "Slider", value = tostring(object.Value) }
    elseif objectType == "Dropdown" then
        return { idx = index, type = "Dropdown", multi = object.Multi == true, value = object.Value }
    elseif objectType == "Input" then
        return { idx = index, type = "Input", text = tostring(object.Value or "") }
    elseif objectType == "ColorPicker" then
        return { idx = index, type = "ColorPicker", value = object.Value:ToHex(), transparency = object.Transparency }
    elseif objectType == "KeyPicker" then
        return { idx = index, type = "KeyPicker", mode = object.Mode, key = object.Value, modifiers = object.Modifiers, toggled = object.Toggled }
    end
    return nil
end

local function exportConfigToTable()
    local objects = {}
    for _, sourceTable in ipairs({ Toggles, Options }) do
        for key, object in pairs(sourceTable) do
            if type(object) == "table" and type(object.Type) == "string" and not SaveManager.Ignore[key] then
                local serialized = serializeObject(key, object)
                if serialized then
                    objects[#objects + 1] = serialized
                end
            end
        end
    end
    table.sort(objects, function(a, b)
        if a.type ~= b.type then return a.type < b.type end
        return a.idx < b.idx
    end)
    return { objects = objects }
end

local function applySerializedObject(data)
    local isMalformed = type(data) ~= "table" or type(data.idx) ~= "string" or type(data.type) ~= "string" or SaveManager.Ignore[data.idx]
    if isMalformed then return false end
    local object = findObjectByType(data.type, data.idx)
    if not object then return false end
    local success = pcall(function()
        if data.type == "Input" then
            if type(data.text) == "string" then object:SetValue(data.text) end
        elseif data.type == "ColorPicker" then
            object:SetValueRGB(Color3.fromHex(data.value), data.transparency)
        elseif data.type == "KeyPicker" then
            object:SetValue({ data.key, data.mode, data.modifiers })
            if data.mode == "Toggle" and data.toggled ~= nil then
                object.Toggled = data.toggled
                object:Update()
            end
        else
            object:SetValue(data.value)
        end
    end)
    return success
end

