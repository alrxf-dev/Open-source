    -- ============ PLAYERS TAB (dynamic) ============
    local playerAdded = {}

    local function UpdatePlayerButtons()
        for _, p in ipairs(game.Players:GetPlayers()) do
            if p ~= game.Players.LocalPlayer and not playerAdded[p.Name] then
                playerAdded[p.Name] = true
                local targetName = p.Name
                PlayersSec:AddButton({
                    Title   = targetName,
                    Content = "Teleport to " .. targetName,
                    Callback = function()
                        local targetPlayer = game.Players:FindFirstChild(targetName)
                        if targetPlayer then
                            local char = targetPlayer.Character
                            if char and char:FindFirstChild("HumanoidRootPart") then
                                local localChar = game.Players.LocalPlayer.Character
                                if localChar and localChar:FindFirstChild("HumanoidRootPart") then
                                    localChar.HumanoidRootPart.CFrame = CFrame.new(char.HumanoidRootPart.CFrame.Position)
                                end
                            end
                        else
                            Window:Notify(targetName .. " is no longer in game", 3)
                        end
                    end
                })
            end
        end
    end

    UpdatePlayerButtons()
    game.Players.PlayerAdded:Connect(function()
        task.wait(1)
        UpdatePlayerButtons()
    end)
    task.spawn(function()
        while task.wait(5) do
            UpdatePlayerButtons()
        end
    end)

    -- Kill key system after success
    if ScreenGui and ScreenGui.Parent then ScreenGui:Destroy() end
end

