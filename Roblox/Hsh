-- ============ AUTO TRAIN LOOP ============

local function autoTrainLoop()
    while true do
        task.wait(0.5)
        if Library.Unloaded then break end
        if not (Toggles.AutoTrain and Toggles.AutoTrain.Value) then
            lastAutoTrainEquipmentId = nil
            continue
        end
        local rebirthState = invokeServer(RebirthStateFunc)
        local rebirths = rebirthState and rebirthState.Rebirths or 0
        local equipmentId = getMaxEquipmentForRebirth(rebirths)
        if equipmentId ~= lastAutoTrainEquipmentId then
            local afkArea = workspace:FindFirstChild("AFK Area")
            local afkPart = afkArea and afkArea:FindFirstChild(tostring(equipmentId))
            local rootPart = getHumanoidRootPart()
            if afkPart and rootPart then
                rootPart.CFrame = afkPart.CFrame + Vector3.new(0, 4, 0)
                lastAutoTrainEquipmentId = equipmentId
            end
        end
    end
end

-- ============ SESSION TIMER ============

local sessionLabel = nil

local function sessionTimerLoop()
    while true do
        task.wait(1)
        if Library.Unloaded then break end
        local elapsed = math.floor(os.clock() - sessionStartTime)
        local display
        if elapsed < 60 then
            display = elapsed .. "s"
        elseif elapsed < 3600 then
            display = string.format("%dm %ds", elapsed // 60, elapsed % 60)
        else
            display = string.format("%dh %dm", elapsed // 3600, elapsed % 3600 // 60)
        end
        if sessionLabel then
            sessionLabel:SetText(formatInfoLine("Session time", display, COLOR_ORANGE))
        end
    end
end

