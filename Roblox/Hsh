-- ============ TELEPORT TO STAGE ============

local function teleportToStage(stageNumber, force)
    local rootPart = getHumanoidRootPart()
    local levelFolder = workspace:FindFirstChild("Level")
    local stageFolder = levelFolder and levelFolder:FindFirstChild(tostring(stageNumber))
    local zoneFolder = stageFolder and stageFolder:FindFirstChild("Zone")
    if not (rootPart and zoneFolder) then return end

    local targetCFrame = zoneFolder.CFrame + Vector3.new(0, 4, 0)
    if force or (rootPart.Position - targetCFrame.Position).Magnitude > 8 then
        rootPart.CFrame = targetCFrame
    end
end

