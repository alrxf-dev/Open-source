    local PlayerModsSec  = PlayerModsTab:AddSection("Mods", true)
    local CredSec        = CredTab:AddSection("Credits", true)
    local PlayersSec     = PlayersTab:AddSection("Teleport to Player", true)

    -- ============ MAIN TAB ============
    MainSec:AddButton({
        Title   = "TP to Japan Lobby",
        Content = "Teleport to Japan Spawn",
        Callback = function()
            local c = game.Players.LocalPlayer.Character
            if c and c:FindFirstChild("HumanoidRootPart") then
                c.HumanoidRootPart.CFrame = CFrame.new(-4.103, -295.5, -36.644)
            end
        end
    })

    MainSec:AddButton({
        Title   = "TP to American Lobby",
        Content = "Teleport to American Spawn",
        Callback = function()
            local c = game.Players.LocalPlayer.Character
            if c and c:FindFirstChild("HumanoidRootPart") then
                c.HumanoidRootPart.CFrame = CFrame.new(15.000, -295.5, 46.505)
            end
        end
    })

    -- Helper: island positions
    local function GetIslandPositions()
        local pos = { A = nil, B = nil, C = nil }
        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Model") and v.Name == "Island" then
                local flag = v:FindFirstChild("Flag")
                local post = flag and flag:FindFirstChild("Post")
                local code = v:FindFirstChild("IslandCode")
                if post and post:IsA("BasePart") and code and code:IsA("StringValue") then
                    if code.Value == "A" then pos.A = post.Position
                    elseif code.Value == "B" then pos.B = post.Position
                    elseif code.Value == "C" then pos.C = post.Position end
                end
            end
        end
        return pos
    end

    local function TPIsland(key)
        local c = game.Players.LocalPlayer.Character
        if not c or not c:FindFirstChild("HumanoidRootPart") then return end
        local pos = GetIslandPositions()
        if pos[key] then
            c.HumanoidRootPart.CFrame = CFrame.new(pos[key].X, pos[key].Y, pos[key].Z)
        else
            Window:Notify("Island " .. key .. " not found", 3)
        end
    end

    MainSec:AddButton({ Title = "TP to Island A", Content = "TP to Island A", Callback = function() TPIsland("A") end })
    MainSec:AddButton({ Title = "TP to Island B", Content = "TP to Island B", Callback = function() TPIsland("B") end })
    MainSec:AddButton({ Title = "TP to Island C", Content = "TP to Island C", Callback = function() TPIsland("C") end })

