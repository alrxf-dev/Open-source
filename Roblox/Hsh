            w:Toggle("Rapid Fire (Hold E)", {flag="toggle1"})
            task.spawn(function()
                while task.wait() do
                    if w.flags.toggle1 then
                        local character = game.Players.LocalPlayer.Character
                        if character and character:FindFirstChild("Humanoid") then
                            local UIS = game:GetService("UserInputService")
                            while w.flags.toggle1 do
                                if UIS:IsKeyDown(Enum.KeyCode.E) then
                                    local tool = character:FindFirstChild("M1 Garand")
                                    if tool then tool:Activate() end
                                end
                                task.wait(0.1)
                            end
                        end
                    end
                end
            end)

            w:Toggle("Kill Opposite Team", {flag="toggle3"})
            task.spawn(function()
                while task.wait(0.1) do
                    if w.flags.toggle3 then
                        local character = game.Players.LocalPlayer.Character
                        if character and character:FindFirstChild("Humanoid") then
                            local myTeam = game.Players.LocalPlayer.Team
                            for _, v in pairs(game.workspace:GetDescendants()) do
                                if v:IsA("Humanoid") and v.Parent and v.Parent:FindFirstChild("HumanoidRootPart") then
                                    local opp = game.Players:GetPlayerFromCharacter(v.Parent)
                                    if opp and opp.Team ~= myTeam then
                                        local HRP = v.Parent:FindFirstChild("HumanoidRootPart")
                                        if HRP then
                                            local Event = game:GetService("ReplicatedStorage"):FindFirstChild("Event")
                                            if Event then
                                                Event:FireServer("shootRifle", "", {HRP})
                                                Event:FireServer("shootRifle", "hit", {v})
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)

            w:Section("Must have RPG GamePass")
            w:Toggle("Shoot RPG", {flag="toggle4"})
            task.spawn(function()
                while task.wait() do
                    if w.flags.toggle4 then
                        local mouse = game.Players.LocalPlayer:GetMouse()
                        local Event = game:GetService("ReplicatedStorage"):FindFirstChild("Event")
                        if Event then
                            Event:FireServer("fireRPG", {[1] = mouse.Hit.p})
                        end
                    end
                end
            end)
        end
    })

    -- ============ CREDITS TAB ============
    CredSec:AddParagraph({
        Title   = "Cracked by boggle.cc team",
