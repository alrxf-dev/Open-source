-- ============ AUTO BUY WEAPON LOOP ============

local function autoBuyWeaponLoop()
    local stop = false
    repeat
        task.wait(0.6)
        if Library.Unloaded then
            stop = true
        elseif Toggles.AutoBuyWeapons and Toggles.AutoBuyWeapons.Value then
            local weaponState = invokeServer(WeaponStateFunc)
            local currencyState = invokeServer(CurrencyFunc)
            if weaponState and currencyState then
                local trophies = currencyState.Trophies or 0
                local unlockedWeapons = weaponState.Unlocked or {}
                local weaponArea = workspace:FindFirstChild("WeaponArea")
                local rootPart = getHumanoidRootPart()
                if weaponArea and rootPart then
                    for index, weaponData in ipairs(WeaponConfig.WEAPONS) do
                        if weaponData.UnlockType == "Trophies" and not unlockedWeapons[tostring(index)] then
                            if trophies >= (weaponData.UnlockCost or math.huge) then
                                local weaponPart = weaponArea:FindFirstChild(tostring(index))
                                if weaponPart and firetouchinterest then
                                    pcall(function()
                                        firetouchinterest(rootPart, weaponPart, 0)
                                        task.wait(0.1)
                                        firetouchinterest(rootPart, weaponPart, 1)
                                    end)
                                end
                                break
                            end
                        end
                    end
                end
            end
        end
    until stop
end

-- ============ AUTO EQUIP LOOP ============

local function autoEquipLoop()
    while true do
        task.wait(1)
        if Library.Unloaded then break end
        if not (Toggles.AutoEquipBest and Toggles.AutoEquipBest.Value) then continue end

        local equipmentState = invokeServer(EquipmentStateFunc)
        if not equipmentState or type(equipmentState.Items) ~= "table" then continue end

        local bestPerSlot = {}
        for _, item in ipairs(equipmentState.Items) do
            local slot = item.Slot
            if slot then
                local current = bestPerSlot[slot]
                if not current or equipmentScore(item) > equipmentScore(current) then
                    bestPerSlot[slot] = item
                end
            end
        end

        local equipped = equipmentState.Equipped or {}
        for slot, bestItem in pairs(bestPerSlot) do
            if equipped[slot] ~= bestItem.Uid then
                pcall(function()
                    EquipItemFunc:InvokeServer(bestItem.Uid)
                end)
            end
        end
    end
end

