-- FIRE AURA
local function SpawnFireAura()
    for i = 1, 20 do
        local p = Instance.new("Frame")
        p.Parent = Window
        p.Size = UDim2.fromOffset(math.random(6, 14), math.random(6, 14))
        p.Position = UDim2.new(math.random(0, 100)/100, 0, math.random(0, 100)/100, 0)
        p.BackgroundColor3 = Color3.fromRGB(255, math.random(200, 255), math.random(200, 255))
        p.BackgroundTransparency = 0.2
        p.BorderSizePixel = 0
        p.ZIndex = 3
        local c = corner(50)
        c.Parent = p
        
        local lifeTime = math.random(60, 120) / 100
        local targetY = p.Position.Y.Offset - math.random(30, 60)
        
        TweenService:Create(p, TweenInfo.new(lifeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(p.Position.X.Scale, p.Position.X.Offset, p.Position.Y.Scale, targetY),
            Size = UDim2.fromOffset(2, 2),
            BackgroundTransparency = 1
        }):Play()
        
        task.delay(lifeTime + 0.1, function()
            pcall(function() p:Destroy() end)
        end)
    end
    
    local glowStroke = stroke(Color3.fromRGB(255, 255, 255), 3)
    glowStroke.Parent = Window
    TweenService:Create(glowStroke, TweenInfo.new(0.6), {
        Transparency = 1
    }):Play()
    task.delay(0.7, function() pcall(function() glowStroke:Destroy() end) end)
end

-- WALLPAPER STATE
local WPState = {
    ImageIndex = 0,
    Active = false,
    Brightness = 0,
    Darkness = 0,
    Zoom = 1,
    PanX = 0,
    PanY = 0,
}

local function applyWallpaper()
    if WPState.Active and WPState.ImageIndex > 0 then
        WallpaperBg.Image = WALLPAPERS[WPState.ImageIndex]
        WallpaperBg.ImageTransparency = 0
        
        for _, data in ipairs(ThemedElements) do
            TweenService:Create(data.elem, TweenInfo.new(0.25), {
                BackgroundTransparency = 0.5
            }):Play()
        end
        TweenService:Create(Window, TweenInfo.new(0.25), {
            BackgroundTransparency = 0.5
        }):Play()
        TweenService:Create(TopBar, TweenInfo.new(0.25), {
            BackgroundTransparency = 0.5
        }):Play()
    else
        WallpaperBg.Image = ""
        WallpaperBg.ImageTransparency = 1
        
        for _, data in ipairs(ThemedElements) do
            TweenService:Create(data.elem, TweenInfo.new(0.25), {
                BackgroundTransparency = data.default or 0
            }):Play()
        end
        TweenService:Create(Window, TweenInfo.new(0.25), {
            BackgroundTransparency = 0
        }):Play()
        TweenService:Create(TopBar, TweenInfo.new(0.25), {
            BackgroundTransparency = 0
        }):Play()
    end
    
    local z = WPState.Zoom
    WallpaperBg.Size = UDim2.new(z, 0, z, 0)
    WallpaperBg.Position = UDim2.new((1-z)/2 + WPState.PanX, 0, (1-z)/2 + WPState.PanY, 0)
    
    if WPState.Brightness > 0 then
        BrightnessOverlay.BackgroundTransparency = 1 - (WPState.Brightness / 100) * 0.9
    else
        BrightnessOverlay.BackgroundTransparency = 1
    end
    
    if WPState.Darkness > 0 then
        DarknessOverlay.BackgroundTransparency = 1 - (WPState.Darkness / 100) * 0.9
    else
        DarknessOverlay.BackgroundTransparency = 1
    end
end

