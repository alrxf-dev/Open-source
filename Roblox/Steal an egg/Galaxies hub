-- ANTI HIT GUARD
-- ============================================================
local ANTI_HIT_SPEED = 0.005
local ANTI_HIT_COOLDOWN = 2.5
local IsAntiHitRunning = false
local lastAntiHit = 0

local function TeleportRouteAndReturn(character)
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    IsAntiHitRunning = true
    local savedCFrame = root.CFrame
    local savedVel = root.AssemblyLinearVelocity
    
    for _, position in ipairs(TeleportPoints) do
        if not State.AntiHitGuard or not root.Parent then
            if root and root.Parent then
                pcall(function()
                    root.CFrame = savedCFrame
                    root.AssemblyLinearVelocity = Vector3.zero
                end)
            end
            IsAntiHitRunning = false
            return
        end
        
        pcall(function()
            root.CFrame = CFrame.new(position)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
        end)
        
        task.wait(ANTI_HIT_SPEED)
    end
    
    task.wait(0.15)
    if root and root.Parent then
        pcall(function()
            root.CFrame = savedCFrame
            root.AssemblyLinearVelocity = savedVel
            root.AssemblyAngularVelocity = Vector3.zero
            if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
        end)
    end
    
    IsAntiHitRunning = false
end

ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
    if player ~= LocalPlayer then return end
    if not State.AntiHitGuard then return end
    if IsAntiHitRunning then return end
    if tick() - lastAntiHit < ANTI_HIT_COOLDOWN then return end
    lastAntiHit = tick()
    
    local character = LocalPlayer.Character
    if not character then return end
    
    task.spawn(function()
        pcall(function() TeleportRouteAndReturn(character) end)
    end)
end)

