-- ANTI LAG - PERFORMANCE MODE
-- ============================================================
local AntiLagStored = {
    Lighting = {}, Effects = {}, Parts = {}, Lights = {}, Decals = {},
    Quality = nil, Quality2 = nil, Terrain = {}, DescendantConn = nil,
}

local function EnableAntiLag()
    pcall(function() if setfpscap then setfpscap(60) end end)
    
    pcall(function()
        local USS = UserSettings and UserSettings() or nil
        if USS then
            local GS = USS:GetService("UserGameSettings")
            if GS then
                AntiLagStored.Quality = GS.SavedQualityLevel
                GS.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
            end
        end
    end)
    pcall(function()
        if settings and settings().Rendering then
            AntiLagStored.Quality2 = settings().Rendering.QualityLevel
            settings().Rendering.QualityLevel = 1
        end
    end)
    
    pcall(function()
        AntiLagStored.Lighting.GlobalShadows = Lighting.GlobalShadows
        AntiLagStored.Lighting.FogEnd = Lighting.FogEnd
        AntiLagStored.Lighting.FogStart = Lighting.FogStart
        AntiLagStored.Lighting.Brightness = Lighting.Brightness
        AntiLagStored.Lighting.EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale
        AntiLagStored.Lighting.EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale
        AntiLagStored.Lighting.ShadowSoftness = Lighting.ShadowSoftness
        
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
        Lighting.FogStart = 0
        Lighting.Brightness = 1
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        Lighting.ShadowSoftness = 0
    end)
    
    pcall(function()
        for _, child in ipairs(Lighting:GetChildren()) do
            if child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("Sky") or child:IsA("Clouds") then
                AntiLagStored.Effects[child] = child.Enabled
                pcall(function() child.Enabled = false end)
            end
        end
    end)
    
    pcall(function()
        local terrain = workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            AntiLagStored.Terrain.WaterWaveSize = terrain.WaterWaveSize
            AntiLagStored.Terrain.WaterWaveSpeed = terrain.WaterWaveSpeed
            AntiLagStored.Terrain.WaterTransparency = terrain.WaterTransparency
            AntiLagStored.Terrain.WaterReflectance = terrain.WaterReflectance
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterTransparency = 1
            terrain.WaterReflectance = 0
        end
    end)
    
    task.spawn(function()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if not State.AntiLag or not State.Running then break end
            pcall(function()
                if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
                    or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                    if obj.Enabled then
                        AntiLagStored.Effects[obj] = true
                        obj.Enabled = false
                    end
                elseif obj:IsA("Light") then
                    if obj.Enabled then
                        AntiLagStored.Lights[obj] = true
                        obj.Enabled = false
                    end
                elseif obj:IsA("BasePart") then
                    if obj.CastShadow then
                        AntiLagStored.Parts[obj] = true
                        obj.CastShadow = false
                    end
                    if obj.Reflectance > 0 then obj.Reflectance = 0 end
                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    if obj.Transparency < 1 then
                        AntiLagStored.Decals[obj] = obj.Transparency
                        obj.Transparency = 1
                    end
                end
            end)
        end
    end)
    
    AntiLagStored.DescendantConn = workspace.DescendantAdded:Connect(function(obj)
        if not State.AntiLag or not State.Running then return end
        pcall(function()
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
                or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                if obj.Enabled then obj.Enabled = false end
            elseif obj:IsA("Light") then
                if obj.Enabled then obj.Enabled = false end
            elseif obj:IsA("BasePart") then
                if obj.CastShadow then obj.CastShadow = false end
                if obj.Reflectance > 0 then obj.Reflectance = 0 end
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 1
            end
        end)
    end)
    
    print("[Anti-Lag] Performance Mode: ON")
end

local function DisableAntiLag()
    pcall(function() if setfpscap then setfpscap(60) end end)
    pcall(function()
        local USS = UserSettings and UserSettings() or nil
        if USS then
            local GS = USS:GetService("UserGameSettings")
            if GS and AntiLagStored.Quality then GS.SavedQualityLevel = AntiLagStored.Quality end
        end
    end)
    pcall(function()
        if settings and settings().Rendering and AntiLagStored.Quality2 then
            settings().Rendering.QualityLevel = AntiLagStored.Quality2
        end
    end)
    pcall(function() for k, v in pairs(AntiLagStored.Lighting) do Lighting[k] = v end end)
    pcall(function()
        for obj, val in pairs(AntiLagStored.Effects) do
            if obj and obj.Parent then pcall(function() obj.Enabled = val end) end
        end
    end)
    pcall(function()
        local terrain = workspace:FindFirstChildOfClass("Terrain")
        if terrain then for k, v in pairs(AntiLagStored.Terrain) do terrain[k] = v end end
    end)
    pcall(function()
        for obj, val in pairs(AntiLagStored.Lights) do
            if obj and obj.Parent then pcall(function() obj.Enabled = val end) end
        end
    end)
    pcall(function()
        for obj, val in pairs(AntiLagStored.Parts) do
            if obj and obj.Parent then pcall(function() obj.CastShadow = val end) end
        end
    end)
    pcall(function()
        for obj, val in pairs(AntiLagStored.Decals) do
            if obj and obj.Parent then pcall(function() obj.Transparency = val end) end
        end
    end)
    if AntiLagStored.DescendantConn then
        pcall(function() AntiLagStored.DescendantConn:Disconnect() end)
        AntiLagStored.DescendantConn = nil
    end
    AntiLagStored.Effects, AntiLagStored.Lights, AntiLagStored.Parts, AntiLagStored.Decals = {}, {}, {}, {}
    print("[Anti-Lag] Performance Mode: OFF")
end

