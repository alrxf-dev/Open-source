-- SLIDERS
local function makeSlider(parent, yOffset, labelText, minVal, maxVal, defaultVal, formatFn, onChange)
    local container = new("Frame", {
        Parent = parent,
        Size = UDim2.new(1, -20, 0, 36),
        Position = UDim2.fromOffset(10, yOffset),
        BackgroundColor3 = Theme.Card,
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        ZIndex = 310,
    }, { corner(8), stroke(Theme.Border, 1) })
    
    local label = new("TextLabel", {
        Parent = container,
        Size = UDim2.new(1, -20, 0, 14),
        Position = UDim2.fromOffset(10, 3),
        BackgroundTransparency = 1,
        Font = FONT_BOLD,
        Text = labelText .. ": " .. formatFn(defaultVal),
        TextColor3 = Theme.Text,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 312,
    })
    
    local bar = new("Frame", {
        Parent = container,
        Size = UDim2.new(1, -20, 0, 8),
        Position = UDim2.fromOffset(10, 22),
        BackgroundColor3 = Color3.fromRGB(200, 200, 205),
        BorderSizePixel = 0,
        ZIndex = 311,
    }, { corner(4) })
    
    local fill = new("Frame", {
        Parent = bar,
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(34, 180, 90),
        BorderSizePixel = 0,
        ZIndex = 312,
    }, { corner(4) })
    
    local knob = new("Frame", {
        Parent = bar,
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.new(0, 0, 0.5, -7),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        ZIndex = 313,
    }, { corner(7), stroke(Color3.fromRGB(150,150,150), 1) })
    
    local currentValue = defaultVal
    local dragging = false
    
    local function setValue(newVal)
        newVal = math.clamp(newVal, minVal, maxVal)
        currentValue = newVal
        local pct = (newVal - minVal) / (maxVal - minVal)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, -7, 0.5, -7)
        label.Text = labelText .. ": " .. formatFn(newVal)
        if onChange then pcall(onChange, newVal) end
    end
    
    setValue(defaultVal)
    
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local relX = (input.Position.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1)
        relX = math.clamp(relX, 0, 1)
        local newVal = minVal + relX * (maxVal - minVal)
        setValue(newVal)
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    return container
end

