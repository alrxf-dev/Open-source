        Font = FONT,
        Text = subtitle,
        TextColor3 = Theme.SubText,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 14,
    })

    local switch = new("Frame", {
        Parent = card,
        Size = UDim2.fromOffset(38,22),
        Position = UDim2.new(1,-50,0.5,-11),
        BackgroundColor3 = Theme.SwitchOff,
        BorderSizePixel = 0,
        ZIndex = 14,
    }, { corner(11), stroke(Theme.Border,1) })

    local knob = new("Frame", {
        Parent = switch,
        Size = UDim2.fromOffset(16,16),
        Position = UDim2.new(0,3,0.5,-8),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BorderSizePixel = 0,
        ZIndex = 15,
    }, { corner(8), stroke(Color3.fromRGB(200,200,205),1) })

    local enabled = false
    local locked = false

    local function setEnabledVisual(v, animate)
        enabled = v
        State[key] = v
        
        local tweenTime = animate and 0.22 or 0
        TweenService:Create(card, TweenInfo.new(tweenTime), {
            BackgroundColor3 = v and Theme.CardOn or Theme.Card
        }):Play()
        TweenService:Create(switch, TweenInfo.new(tweenTime), {
            BackgroundColor3 = v and Theme.SwitchOn or Theme.SwitchOff
        }):Play()
        TweenService:Create(knob, TweenInfo.new(tweenTime), {
            Position = v and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8)
        }):Play()
    end

    local function setLockedVisual(v)
        locked = v
        if v then
            TweenService:Create(card, TweenInfo.new(0.2), { BackgroundColor3 = Theme.CardDisabled }):Play()
            TweenService:Create(titleLbl, TweenInfo.new(0.2), { TextColor3 = Theme.TextDisabled }):Play()
            TweenService:Create(subLbl, TweenInfo.new(0.2), { TextColor3 = Theme.TextDisabled }):Play()
            TweenService:Create(switch, TweenInfo.new(0.2), { BackgroundColor3 = Theme.SwitchDisabled }):Play()
        else
            TweenService:Create(card, TweenInfo.new(0.2), {
                BackgroundColor3 = enabled and Theme.CardOn or Theme.Card
            }):Play()
            TweenService:Create(titleLbl, TweenInfo.new(0.2), { TextColor3 = Theme.Text }):Play()
            TweenService:Create(subLbl, TweenInfo.new(0.2), { TextColor3 = Theme.SubText }):Play()
            TweenService:Create(switch, TweenInfo.new(0.2), {
                BackgroundColor3 = enabled and Theme.SwitchOn or Theme.SwitchOff
            }):Play()
        end
    end

    local toggleObj = {
        key = key,
        getEnabled = function() return enabled end,
        getLocked = function() return locked end,
        setEnabled = setEnabledVisual,
        setLocked = setLockedVisual,
        onToggle = onToggle,
        exclusiveGroup = exclusiveGroup,
    }

    if exclusiveGroup then
        ToggleRegistry[exclusiveGroup] = ToggleRegistry[exclusiveGroup] or {}
        table.insert(ToggleRegistry[exclusiveGroup], toggleObj)
    end

    card.Activated:Connect(function()
        if locked then
            playClick()
            return
        end
        playClick()

        local newVal = not enabled

        if newVal and exclusiveGroup and ToggleRegistry[exclusiveGroup] then
            for _, other in ipairs(ToggleRegistry[exclusiveGroup]) do
                if other ~= toggleObj then
                    if other.getEnabled() then
                        other.setEnabled(false, true)
                        if other.onToggle then pcall(other.onToggle, false) end
                    end
                    other.setLocked(true)
                end
            end
        end

        if not newVal and exclusiveGroup and ToggleRegistry[exclusiveGroup] then
            for _, other in ipairs(ToggleRegistry[exclusiveGroup]) do
                if other ~= toggleObj then
                    other.setLocked(false)
                end
            end
        end

        setEnabledVisual(newVal, true)
        if onToggle then pcall(onToggle, newVal) end
    end)
end

